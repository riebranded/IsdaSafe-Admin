SUPABASE_URL=
SUPABASE_ANON_KEY=
# Same Cloudflare Turnstile site key as the farmer app (CAPTCHA is enforced
# project-wide by Supabase Auth).
TURNSTILE_SITE_KEY=

# Web OAuth client ID (Google Cloud), used as serverClientId for native
# Google Sign-In on Android. Web uses Supabase's OAuth redirect instead.
GOOGLE_WEB_CLIENT_ID=

# The deployed admin panel's address, e.g. https://isdasafe-admin.vercel.app
# (no trailing slash). Email links (like confirming a new email) go here, so
# they work on a phone even when requested from a local build. Add
# https://<this address>/** to Supabase's Redirect URLs.
SITE_URL=
